{
    "manifest_version": 3,
    "name": "Memory Watcher",
    "version": "1.4",
    "description": "Monitor the tab's memory usage and send toast-style alerts when it exceeds the configured limit.",
    "permissions": ["storage", "tabs", "scripting"],
    "author": "Yagasaki7K",
    "action": {
        "default_title": "Memory Watcher Options",
        "default_popup": "options.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content-script.js"],
            "css": ["toast.css"]
        }
    ],
    "options_page": "options.html"
}
